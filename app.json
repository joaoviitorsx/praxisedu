{
  "expo": {
    "name": "Práxis Edu",
    "slug": "praxis-edu",
    "scheme": "praxisedu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.edu.unifor.praxisedu",
      "userInterfaceStyle": "light",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "O Práxis Edu precisa acessar a rede local para conectar ao servidor de desenvolvimento durante os testes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-router",
      "expo-video",
      "expo-web-browser",
      "expo-image",
      "expo-audio"
    ]
  }
}
